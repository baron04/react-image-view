{
  "name": "react-img-view",
  "version": "0.2.0",
  "description": "React image viewer and lightbox component: zoom, pan, pinch, rotate, fit-to-window and 1:1, keyboard and touch. Headless and composable, built for previewing document attachments and admin image fields.",
  "homepage": "https://baron04.github.io/react-img-view",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baron04/react-img-view.git"
  },
  "bugs": {
    "url": "https://github.com/baron04/react-img-view/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "baron04",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "registry:build": "shadcn build --output docs-site/public/r",
    "registry:check": "node scripts/check-registry.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.19.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "react-image-viewer",
    "image-viewer",
    "react-image-preview",
    "image-preview",
    "lightbox",
    "react-lightbox",
    "photo-viewer",
    "image",
    "viewer",
    "preview",
    "gallery",
    "modal",
    "zoom",
    "pan",
    "pinch-zoom",
    "rotate",
    "pinch",
    "headless",
    "composable",
    "accessible",
    "a11y",
    "typescript",
    "attachment",
    "document-viewer"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.1"
}
